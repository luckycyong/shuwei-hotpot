<view class="page-mine">
  <!-- 头部 -->
  <view class="mine-header">
    <view class="avatar">🍲</view>
    <text class="shop-name">蜀味火锅</text>
    <text class="shop-slogan">地道成都味，麻辣鲜香</text>
  </view>

  <!-- 数据统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{totalOrders}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{reviewCount}}</text>
      <text class="stat-label">全部评价</text>
    </view>
    <view class="stat-item">
      <text class="stat-num {{isGuest ? 'guest' : ''}}">{{tableNo}}</text>
      <text class="stat-label">{{isGuest ? '浏览模式' : '当前桌号'}}</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="func-list">
    <!-- 顾客评价（入口突出显示，游客也可查看） -->
    <view class="func-item func-item-highlight" bindtap="viewReviews">
      <view class="func-item-left">
        <text class="func-icon">📝</text>
        <text class="func-text">顾客评价</text>
      </view>
      <view class="func-item-right">
        <text class="func-badge" wx:if="{{reviewCount > 0}}">{{reviewCount}}</text>
        <text class="func-arrow">›</text>
      </view>
    </view>

    <view class="func-item" bindtap="changeTable">
      <text>🪑 {{isGuest ? '绑定桌号' : '切换桌号'}}</text>
      <text class="func-arrow">›</text>
    </view>
    <navigator url="/pages/order/order" open-type="switchTab" class="func-item">
      <text>📋 查看订单</text>
      <text class="func-arrow">›</text>
    </navigator>
    <view class="func-item" bindtap="contactShop">
      <text>📞 联系门店</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="clearAllData">
      <text style="color:#e74c3c;">🗑 清除数据</text>
      <text class="func-arrow" style="color:#e74c3c;">›</text>
    </view>
  </view>

  <!-- 游客提示 -->
  <view class="guest-tip" wx:if="{{isGuest}}">
    <text class="guest-tip-icon">👤</text>
    <text class="guest-tip-text">您当前为游客模式，绑定桌号后可下单点餐</text>
  </view>

  <!-- 管理员入口 -->
  <view class="admin-entry" bindtap="goAdmin">
    <text class="admin-entry-icon">🔐</text>
    <text class="admin-entry-text">后台管理</text>
  </view>

  <view class="footer-text">蜀味火锅 v1.0 · 自助点餐系统</view>
</view>
