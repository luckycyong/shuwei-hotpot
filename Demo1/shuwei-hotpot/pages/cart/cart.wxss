/* ============================================================
   购物车页面样式 — 微信支付版
   ============================================================ */

.page-cart {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* -------- 头部 -------- */
.cart-header {
  padding: 20rpx 28rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border);
}
.cart-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cart-title {
  font-size: 36rpx;
  font-weight: 800;
}
.table-info {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  background: #fff0ed;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.cart-header-right {
  display: flex;
  align-items: center;
}
.wechat-badge {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* -------- 空状态 -------- */
.empty-cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.empty-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 32rpx; font-weight: 700; color: var(--text-secondary); }
.empty-sub { font-size: 26rpx; color: var(--text-light); margin: 12rpx 0 30rpx; }
.go-menu-btn {
  padding: 18rpx 48rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-decoration: none;
}

/* -------- 购物车列表 -------- */
.cart-scroll {
  flex: 1;
  overflow-y: auto;
}
.cart-list {
  padding: 16rpx 20rpx;
}
.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 12rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.item-image {
  font-size: 60rpx;
  width: 90rpx;
  text-align: center;
}
.item-info {
  flex: 1;
  margin-left: 16rpx;
}
.item-name {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
}
.item-price {
  font-size: 24rpx;
  color: var(--text-light);
}
.item-actions {
  text-align: right;
  min-width: 160rpx;
}
.qty-control {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-bottom: 6rpx;
}
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: #f5f5f5;
  color: var(--text);
}
.qty-btn:active { background: #ddd; }
.qty-num {
  font-size: 30rpx;
  font-weight: 700;
  min-width: 48rpx;
  text-align: center;
}
.item-subtotal {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 700;
}
.item-remove {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: 30rpx;
  padding: 4rpx;
  opacity: 0.5;
}

/* -------- 温馨提示 -------- */
.cart-tips {
  padding: 0 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.tip-item {
  font-size: 22rpx;
  color: var(--text-light);
}

/* -------- 底部结算栏（微信支付版） -------- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  background: #fff;
  border-top: 2rpx solid var(--border);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}

/* 左侧：清空按钮 */
.bottom-left {
  min-width: 80rpx;
}
.clear-btn {
  font-size: 24rpx;
  color: #999;
}

/* 中间：金额汇总 */
.bottom-center {
  flex: 1;
  text-align: center;
}
.summary-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.count-highlight {
  color: var(--primary);
  font-weight: 800;
  font-size: 28rpx;
}
.total-price-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 12rpx;
}
.total-price-num {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--primary);
  margin-left: 6rpx;
}

/* 右侧：微信支付按钮 */
.bottom-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.checkout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  padding: 18rpx 32rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.35);
  transition: all 0.2s;
}
.checkout-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.checkout-btn.paying {
  background: #a0a0a0;
  box-shadow: none;
}
.btn-icon {
  font-size: 30rpx;
  margin-right: 8rpx;
}
.btn-text {
  letter-spacing: 2rpx;
}
.btn-loading {
  font-size: 26rpx;
}
.pay-hint {
  font-size: 20rpx;
  color: var(--text-light);
}
