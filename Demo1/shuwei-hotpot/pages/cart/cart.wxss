.page-cart { display: flex; flex-direction: column; height: 100vh; background: var(--bg); }
        .cart-header {
        padding: 24rpx 28rpx; background: #fff; display: flex;
        justify-content: space-between; align-items: center; border-bottom: 1rpx solid var(--border);
        }
        .cart-title { font-size: 36rpx; font-weight: 800; }
        .table-info { font-size: 26rpx; color: var(--primary); font-weight: 600; }

        .empty-cart {
        flex: 1; display: flex; flex-direction: column; align-items: center;
        justify-content: center; padding: 60rpx;
        }
        .empty-icon { font-size: 120rpx; margin-bottom: 20rpx; }
        .empty-text { font-size: 32rpx; font-weight: 700; color: var(--text-secondary); }
        .empty-sub { font-size: 26rpx; color: var(--text-light); margin: 12rpx 0 30rpx; }
        .go-menu-btn {
        padding: 18rpx 48rpx; background: var(--primary); color: #fff;
        border-radius: 40rpx; font-size: 28rpx; font-weight: 600; text-decoration: none;
        }

        .cart-list { flex: 1; overflow-y: auto; padding: 16rpx 20rpx; }
        .cart-item {
        display: flex; align-items: center; background: #fff; border-radius: var(--radius-sm);
        padding: 20rpx; margin-bottom: 12rpx; position: relative; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
        }
        .item-image { font-size: 60rpx; width: 90rpx; text-align: center; }
        .item-info { flex: 1; margin-left: 16rpx; }
        .item-name { font-size: 28rpx; font-weight: 700; display: block; }
        .item-price { font-size: 24rpx; color: var(--text-light); }
        .item-actions { text-align: right; }
        .qty-control { display: flex; align-items: center; gap: 4rpx; margin-bottom: 6rpx; }
        .qty-btn {
        width: 48rpx; height: 48rpx; border-radius: 50%; text-align: center;
        line-height: 48rpx; font-size: 28rpx; font-weight: 700;
        background: #f5f5f5; color: var(--text);
        }
        .qty-btn:active { background: #ddd; }
        .qty-num { font-size: 30rpx; font-weight: 700; min-width: 48rpx; text-align: center; }
        .item-subtotal { font-size: 26rpx; color: var(--primary); font-weight: 700; }
        .item-remove {
        position: absolute; top: 12rpx; right: 16rpx; font-size: 30rpx;
        padding: 4rpx; opacity: 0.5;
        }

        .bottom-bar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 20rpx 24rpx; background: #fff; border-top: 1rpx solid var(--border);
        box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); padding-bottom: env(safe-area-inset-bottom);
        }
        .clear-btn { font-size: 26rpx; color: #999; }
        .count-highlight { color: var(--primary); font-weight: 800; font-size: 30rpx; }
        .total-price { font-size: 28rpx; font-weight: 700; margin-right: 16rpx; }
        .checkout-btn {
        padding: 16rpx 36rpx; background: linear-gradient(135deg, #d4380d, #c02d08);
        color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: 700;
        border: none; display: inline-block;
        }