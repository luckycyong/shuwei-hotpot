.page-menu-edit { min-height: 100vh; background: var(--bg); padding-bottom: 60rpx; }

.form-wrap { padding: 20rpx 24rpx; }

/* 分区 */
.form-section {
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.form-section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  display: block;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--border);
}

/* 字段 */
.form-field { margin-bottom: 20rpx; }
.form-field:last-child { margin-bottom: 0; }
.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}
.form-input {
  width: 100%;
  height: 72rpx;
  background: #f8f8f8;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #f8f8f8;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 行内布局 */
.form-row {
  display: flex;
  gap: 16rpx;
}
.form-field-half { flex: 1; }

/* 选择器 */
.form-picker {
  background: #f8f8f8;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
.picker-view { display: flex; align-items: center; height: 100%; }

/* emoji 图标选择 */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.emoji-item {
  width: 64rpx;
  height: 64rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 36rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.emoji-item.active {
  background: #fff0ed;
  border-color: var(--primary);
}

/* 辣度选择 */
.spicy-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.spicy-option {
  padding: 10rpx 20rpx;
  background: #f8f8f8;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 2rpx solid transparent;
}
.spicy-option.active {
  background: #fff0ed;
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 图片上传 */
.img-upload-row { display: flex; gap: 12rpx; }
.form-input-flex { flex: 1; }
.upload-btn {
  flex-shrink: 0; padding: 0 24rpx; height: 72rpx; line-height: 72rpx;
  background: var(--primary); color: #fff; border-radius: var(--radius-sm);
  font-size: 26rpx; font-weight: 600; border: none; text-align: center; display: inline-block;
}
.img-preview { width: 200rpx; height: 200rpx; border-radius: var(--radius-sm); margin-top: 12rpx; }
.img-tip { font-size: 20rpx; color: var(--text-light); display: block; margin-top: 8rpx; }

/* 提交按钮 */
.form-submit { margin-top: 20rpx; }
.submit-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #d4380d, #c02d08);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  line-height: 80rpx;
  margin-bottom: 16rpx;
}
.submit-btn.disabled { opacity: 0.6; }
.cancel-btn {
  width: 100%;
  height: 76rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 76rpx;
}
.form-submit-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}
.form-hint {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
}
