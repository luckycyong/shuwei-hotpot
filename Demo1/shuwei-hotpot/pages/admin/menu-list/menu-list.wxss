.page-menu-list { display: flex; flex-direction: column; min-height: 100vh; background: var(--bg); }

/* 顶栏 */
.ml-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 28rpx; background: #fff; border-bottom: 1rpx solid var(--border);
}
.ml-title { font-size: 34rpx; font-weight: 800; }
.ml-add-btn {
  padding: 14rpx 28rpx; background: var(--primary); color: #fff;
  border-radius: 40rpx; font-size: 26rpx; font-weight: 700; border: none;
}

/* 搜索 */
.ml-search { padding: 16rpx 24rpx; }
.ml-search-input {
  width: 100%; height: 68rpx; background: #fff; border-radius: 40rpx;
  padding: 0 28rpx; font-size: 26rpx; box-shadow: var(--shadow); box-sizing: border-box;
}

/* 分类Tab */
.ml-cat-scroll {
  white-space: nowrap; padding: 0 20rpx 12rpx; display: flex;
}
.ml-cat-item {
  display: inline-block; padding: 12rpx 24rpx; margin: 0 6rpx;
  background: #fff; border-radius: 30rpx; font-size: 24rpx; font-weight: 600;
  color: var(--text-secondary); box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.ml-cat-item.active { background: var(--primary); color: #fff; }

/* 状态筛选 */
.ml-status-row {
  display: flex; padding: 0 20rpx 12rpx; gap: 12rpx;
}
.ml-status-item {
  padding: 8rpx 24rpx; border-radius: 20rpx; font-size: 22rpx;
  font-weight: 600; background: #f0f0f0; color: #888;
}
.ml-status-item.active { background: var(--primary); color: #fff; }
.ml-status-item.ml-status-on { color: #52c41a; background: #f6ffed; }
.ml-status-item.ml-status-on.active { background: #52c41a; color: #fff; }
.ml-status-item.ml-status-off { color: #999; background: #f5f5f5; }
.ml-status-item.ml-status-off.active { background: #999; color: #fff; }

/* 加载/空状态 */
.ml-loading, .ml-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 60rpx;
}
.ml-empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.ml-empty-text { font-size: 28rpx; font-weight: 700; color: var(--text-secondary); }
.ml-empty-hint { font-size: 24rpx; color: var(--text-light); margin-top: 8rpx; }

/* 菜品列表 */
.ml-scroll { flex: 1; padding: 0 20rpx; }
.ml-item {
  background: #fff; border-radius: var(--radius); padding: 20rpx;
  margin-top: 14rpx; box-shadow: var(--shadow); position: relative;
}
.ml-item-left { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.ml-item-icon { font-size: 56rpx; width: 72rpx; text-align: center; }
.ml-item-img { width: 72rpx; height: 72rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
.ml-item-info { flex: 1; }
.ml-item-name-row { display: flex; align-items: center; gap: 10rpx; }
.ml-item-name { font-size: 28rpx; font-weight: 700; }
.ml-item-badge {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 12rpx; font-weight: 600;
}
.badge-on { background: #f6ffed; color: #52c41a; }
.badge-off { background: #f5f5f5; color: #999; }
.ml-item-cat { font-size: 22rpx; color: var(--text-light); display: block; margin: 2rpx 0; }
.ml-item-desc { font-size: 22rpx; color: var(--text-light); display: block; }
.ml-item-tags { display: flex; gap: 6rpx; margin-top: 6rpx; }
.ml-tag {
  font-size: 20rpx; background: #fff0ed; color: #d4380d;
  padding: 2rpx 12rpx; border-radius: 12rpx;
}

.ml-item-right {
  display: flex; align-items: baseline; gap: 6rpx;
  margin-bottom: 12rpx;
}
.ml-item-price { font-size: 32rpx; font-weight: 800; color: var(--primary); }
.ml-item-unit { font-size: 22rpx; color: var(--text-light); }
.ml-item-sales { font-size: 22rpx; color: var(--text-light); margin-left: auto; }

/* 操作按钮 */
.ml-item-actions { display: flex; gap: 10rpx; border-top: 1rpx solid #f5f5f5; padding-top: 14rpx; }
.ml-action-btn {
  flex: 1; padding: 12rpx 0; border-radius: 24rpx; font-size: 22rpx;
  font-weight: 600; border: none; text-align: center;
}
.action-edit { background: #e6f7ff; color: #1890ff; }
.action-status { background: #f6ffed; color: #52c41a; }
.action-del { background: #fff2f0; color: #e74c3c; }

/* 折扣价 */
.ml-item-price-old { font-size: 24rpx; color: #bbb; text-decoration: line-through; margin-right: 6rpx; }
.ml-item-price.discount { color: #e74c3c; }
.ml-item-sales { font-size: 22rpx; color: var(--text-light); margin-left: auto; }
